{{> navbar}}

<div class="container-fluid bg-primary py-5 mb-5 hero-header" style="height: 40vh;">
    <div class="container py-5">
        <div class="row justify-content-center">
            <div class="col-lg-10 text-center">
                <h1 class="display-3 text-white animated slideInDown">Search Results</h1>
                <nav aria-label="breadcrumb">
                    <ol class="breadcrumb justify-content-center">
                        <li class="breadcrumb-item"><a class="text-white" href="/">Home</a></li>
                        <li class="breadcrumb-item text-white active" aria-current="page">Search</li>
                    </ol>
                </nav>
            </div>
        </div>
    </div>
</div>

<div class="container-xxl py-5">
    <div class="container">
        <div class="section-title text-center">
            <h5 class="text-primary text-uppercase">Results</h5>
            <h1 class="mb-5">Found Items</h1>
        </div>

        <div class="row g-4">
            {{#if result}}
            {{#each result}}
            <div class="col-lg-3 col-md-4 col-sm-6 wow fadeInUp" data-wow-delay="0.1s">
                <div class="modern-card p-4 h-100 text-center">
                    <div class="mb-3">
                        <i class="fas fa-search fa-3x text-primary"></i>
                    </div>
                    <h5 class="mb-2">{{this.subject}}</h5>
                    <p class="text-muted small mb-3">{{this.semester}} - {{this.department}}</p>

                    {{#if ../user}}
                    <a href="/docs/{{this._id}}.pdf" download class="btn btn-sm btn-outline-primary w-100">
                        <i class="fas fa-download me-2"></i>Download
                    </a>
                    {{else}}
                    <p class="text-danger small"><i class="fas fa-lock me-1"></i>Login to download</p>
                    {{/if}}
                </div>
            </div>
            {{/each}}
            {{else}}
            <div class="col-12 text-center">
                <div class="alert alert-warning" role="alert">
                    No results found for your search query. Please try different keywords.
                </div>
                <a href="/" class="btn btn-primary mt-3">Back to Home</a>
            </div>
            {{/if}}
        </div>
    </div>
</div>

{{> footer}}