{{> navbar}}

<div class="container-fluid bg-primary py-5 mb-5 hero-header"
    style="height: 50vh; background-image: url('https://images.pexels.com/photos/159298/gears-cogs-machine-machinery-159298.jpeg');">
    <div class="container py-5">
        <div class="row justify-content-center">
            <div class="col-lg-10 text-center">
                <h1 class="display-3 text-white animated slideInDown">Mechanical Engineering</h1>
                <nav aria-label="breadcrumb">
                    <ol class="breadcrumb justify-content-center">
                        <li class="breadcrumb-item"><a class="text-white" href="/">Home</a></li>
                        <li class="breadcrumb-item text-white active" aria-current="page">Mechanical Engineering</li>
                    </ol>
                </nav>
            </div>
        </div>
    </div>
</div>

<div class="container-xxl py-5">
    <div class="container">
        <!-- Faculty Section -->
        <div class="section-title text-center">
            <h5 class="text-primary text-uppercase">Faculty</h5>
            <h1 class="mb-5">Our Staff Members</h1>
        </div>
        <div class="row g-4 mb-5">
            {{#if staffs}}
            {{#each staffs}}
            <div class="col-lg-3 col-md-6 wow fadeInUp" data-wow-delay="0.1s">
                <div class="team-item bg-light rounded overflow-hidden">
                    <div class="position-relative">
                        <img class="img-fluid w-100" src="/img/staff/{{_id}}.jpg" alt="{{this.Name}}"
                            style="height: 250px; object-fit: cover;">
                    </div>
                    <div class="text-center p-4">
                        <h5 class="mb-1">{{this.staff_name}}</h5>
                        <small class="text-muted d-block mb-2">{{this.position}}</small>
                        <div class="d-flex justify-content-center">
                            <a class="btn btn-square btn-outline-primary mx-1 rounded-circle"
                                href="mailto:{{this.email}}"><i class="fas fa-envelope"></i></a>
                            <a class="btn btn-square btn-outline-primary mx-1 rounded-circle"
                                href="tel:{{this.phone}}"><i class="fas fa-phone"></i></a>
                        </div>
                    </div>
                </div>
            </div>
            {{/each}}
            {{else}}
            <div class="col-12 text-center">
                <p class="text-muted">No faculty members listed yet.</p>
            </div>
            {{/if}}
        </div>

        <!-- Question Papers Section -->
        <div class="section-title text-center">
            <h5 class="text-primary text-uppercase">Downloads</h5>
            <h1 class="mb-5">Question Papers</h1>
        </div>
        <div class="row g-4 mb-5">
            {{#if questions}}
            {{#each questions}}
            <div class="col-lg-3 col-md-4 col-sm-6 wow fadeInUp" data-wow-delay="0.1s">
                <div class="modern-card p-4 h-100 text-center">
                    <div class="mb-3">
                        <i class="fas fa-file-alt fa-3x text-primary"></i>
                    </div>
                    <h5 class="mb-2">{{this.subject}}</h5>
                    <p class="text-muted small mb-3">{{this.semester}} | {{this.year_month}}</p>

                    {{#if ../user}}
                    <a href="/questions/{{this._id}}.pdf" download class="btn btn-sm btn-outline-primary w-100">
                        <i class="fas fa-download me-2"></i>Download
                    </a>
                    {{else}}
                    <p class="text-danger small"><i class="fas fa-lock me-1"></i>Login to download</p>
                    {{/if}}
                </div>
            </div>
            {{/each}}
            {{else}}
            <div class="col-12 text-center">
                <p class="text-muted">No question papers available.</p>
            </div>
            {{/if}}
        </div>

        <!-- Study Materials Section -->
        <div class="section-title text-center">
            <h5 class="text-primary text-uppercase">Resources</h5>
            <h1 class="mb-5">Study Materials</h1>
        </div>
        <div class="row g-4 mb-5">
            {{#if material}}
            {{#each material}}
            <div class="col-lg-3 col-md-4 col-sm-6 wow fadeInUp" data-wow-delay="0.1s">
                <div class="modern-card p-4 h-100 text-center">
                    <div class="mb-3">
                        <i class="fas fa-book fa-3x text-success"></i>
                    </div>
                    <h5 class="mb-2">{{this.subject}}</h5>
                    <p class="text-muted small mb-3">{{this.semester}}</p>

                    {{#if ../user}}
                    <a href="/docs/{{this._id}}.pdf" download class="btn btn-sm btn-outline-success w-100">
                        <i class="fas fa-download me-2"></i>Download
                    </a>
                    {{else}}
                    <p class="text-danger small"><i class="fas fa-lock me-1"></i>Login to download</p>
                    {{/if}}
                </div>
            </div>
            {{/each}}
            {{else}}
            <div class="col-12 text-center">
                <p class="text-muted">No study materials available.</p>
            </div>
            {{/if}}
        </div>

        <!-- Gallery Section -->
        <div class="section-title text-center">
            <h5 class="text-primary text-uppercase">Gallery</h5>
            <h1 class="mb-5">Department Moments</h1>
        </div>
        <div class="row g-4">
            {{#each photos}}
            <div class="col-lg-4 col-md-6 wow fadeInUp" data-wow-delay="0.1s">
                <div class="team-item rounded overflow-hidden">
                    <div class="position-relative">
                        <img class="img-fluid w-100" src="/img/gallery/{{_id}}.jpg" alt="{{this.title}}"
                            style="height: 250px; object-fit: cover;">
                        <div class="team-overlay">
                            <div class="d-flex align-items-center justify-content-center">
                                <span class="text-white fw-bold">{{this.title}}</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            {{/each}}
        </div>
    </div>
</div>

{{> footer}}