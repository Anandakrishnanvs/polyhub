{{> navbar}}
{{#if errorMessage}}
<div class="alert alert-danger alert-dismissible fade show m-0 text-center rounded-0" role="alert">
    <strong>Error:</strong> {{errorMessage}}
    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
</div>
{{/if}}
<div class="hero-header">
    <div class="container text-center">
        <div class="row justify-content-center">
            <div class="col-lg-8">
                <h1 class="display-3 text-white animated slideInDown mb-4">Education is the Passport to the Future</h1>
                <p class="fs-5 text-white mb-5 pb-2">Empowering the next generation of technicians and engineers with
                    quality education and practical skills.</p>

                <div class="search-container animated slideInUp">
                    <form action="/searchMaterial" method="post" class="w-100 d-flex">
                        <input type="text" name="subject" class="search-input"
                            placeholder="Search for study materials, question papers...">
                        <button type="submit" class="search-btn">
                            <i class="fa fa-search"></i>
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Notification Bar -->
<div class="notification-bar">
    <div class="container-fluid">
        <div class="d-flex align-items-center">
            <span class="badge bg-secondary me-3">LATEST NEWS</span>
            <div class="news-ticker">
                {{#each notificationList}}
                <span class="me-5"><i class="fas fa-bell me-2"></i><strong>{{title}}</strong>: {{content}}</span>
                {{/each}}
            </div>
        </div>
    </div>
</div>

<!-- Departments Section -->
<div class="container-fluid py-5">
    <div class="container">
        <div class="section-title">
            <h5>Our Departments</h5>
            <h1>Explore Courses</h1>
        </div>

        <div class="row g-4">
            <!-- Computer Engineering -->
            <div class="col-lg-4 col-md-6 wow fadeInUp" data-wow-delay="0.1s">
                <a href="/Computer">
                    <div class="team-item">
                        <div class="overflow-hidden position-relative">
                            <img class="img-fluid"
                                src="https://images.pexels.com/photos/3861972/pexels-photo-3861972.jpeg"
                                alt="Computer Engineering">
                        </div>
                        <div class="team-text text-center">
                            <div class="bg-light p-4">
                                <h4 class="mb-0">Computer Engineering</h4>
                                <small class="text-muted">Software & Hardware</small>
                            </div>
                        </div>
                    </div>
                </a>
            </div>

            <!-- Civil Engineering -->
            <div class="col-lg-4 col-md-6 wow fadeInUp" data-wow-delay="0.3s">
                <a href="/civil">
                    <div class="team-item">
                        <div class="overflow-hidden position-relative">
                            <img class="img-fluid" src="https://th.bing.com/th/id/OIP.l4rs6rD4UUVrOkhsWLiEzQHaEK"
                                alt="Civil Engineering">
                        </div>
                        <div class="team-text text-center">
                            <div class="bg-light p-4">
                                <h4 class="mb-0">Civil Engineering</h4>
                                <small class="text-muted">Construction & Design</small>
                            </div>
                        </div>
                    </div>
                </a>
            </div>

            <!-- Mechanical Engineering -->
            <div class="col-lg-4 col-md-6 wow fadeInUp" data-wow-delay="0.5s">
                <a href="/mech">
                    <div class="team-item">
                        <div class="overflow-hidden position-relative">
                            <img class="img-fluid"
                                src="https://images.pexels.com/photos/159298/gears-cogs-machine-machinery-159298.jpeg"
                                alt="Mechanical Engineering">
                        </div>
                        <div class="team-text text-center">
                            <div class="bg-light p-4">
                                <h4 class="mb-0">Mechanical Engineering</h4>
                                <small class="text-muted">Machines & Mechanics</small>
                            </div>
                        </div>
                    </div>
                </a>
            </div>

            <!-- Electronics Engineering -->
            <div class="col-lg-4 col-md-6 wow fadeInUp" data-wow-delay="0.1s">
                <a href="/ec">
                    <div class="team-item">
                        <div class="overflow-hidden position-relative">
                            <img class="img-fluid"
                                src="https://images.pexels.com/photos/159220/printed-circuit-board-print-plate-via-macro-159220.jpeg"
                                alt="Electronics Engineering">
                        </div>
                        <div class="team-text text-center">
                            <div class="bg-light p-4">
                                <h4 class="mb-0">Electronics Engineering</h4>
                                <small class="text-muted">Circuits & Systems</small>
                            </div>
                        </div>
                    </div>
                </a>
            </div>

            <!-- Electrical Engineering -->
            <div class="col-lg-4 col-md-6 wow fadeInUp" data-wow-delay="0.3s">
                <a href="/eee">
                    <div class="team-item">
                        <div class="overflow-hidden position-relative">
                            <img class="img-fluid"
                                src="https://images.pexels.com/photos/236089/pexels-photo-236089.jpeg"
                                alt="Electrical Engineering">
                        </div>
                        <div class="team-text text-center">
                            <div class="bg-light p-4">
                                <h4 class="mb-0">Electrical Engineering</h4>
                                <small class="text-muted">Power & Energy</small>
                            </div>
                        </div>
                    </div>
                </a>
