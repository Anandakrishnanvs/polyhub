{{> navbar}}

<div class="container-fluid bg-primary py-5 mb-5 hero-header" style="height: 40vh;">
  <div class="container py-5">
    <div class="row justify-content-center">
      <div class="col-lg-10 text-center">
        <h1 class="display-3 text-white animated slideInDown">Forms & Applications</h1>
        <nav aria-label="breadcrumb">
          <ol class="breadcrumb justify-content-center">
            <li class="breadcrumb-item"><a class="text-white" href="/">Home</a></li>
            <li class="breadcrumb-item text-white active" aria-current="page">Forms</li>
          </ol>
        </nav>
      </div>
    </div>
  </div>
</div>

<div class="container-xxl py-5">
  <div class="container">
    <div class="row g-4">
      {{#if forms}}
      {{#each forms}}
      <div class="col-lg-4 col-md-6 wow fadeInUp" data-wow-delay="0.1s">
        <div class="modern-card p-4 h-100 text-center">
          <div class="mb-3">
            <i class="far fa-file-pdf fa-3x text-danger"></i>
          </div>
          <h5 class="mb-2">{{this.title}}</h5>
          <p class="text-muted small mb-3">{{this.description}}</p>

          <a href="/forms/{{this._id}}.pdf" download class="btn btn-sm btn-outline-danger w-100">
            <i class="fas fa-download me-2"></i>Download Form
          </a>
        </div>
      </div>
      {{/each}}
      {{else}}
      <div class="col-12 text-center">
        <div class="alert alert-info" role="alert">
          No forms available currently.
        </div>
      </div>
      {{/if}}
    </div>
  </div>
</div>

{{> footer}}